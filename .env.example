# ===== Hayko Order Manager — Environment Variables (TEMPLATE) =====
# Copy file ini menjadi ".env.local" untuk dev lokal, atau set di Vercel dashboard untuk production.

# --- WAJIB: Apps Script Web App URL ---
# Didapat setelah deploy Code.gs sebagai Web App di spreadsheet "MASTER REKAP HAYKO".
# Format: https://script.google.com/macros/s/XXXX/exec
SHEETS_API_URL=

# --- OPSIONAL: Token rahasia Apps Script ---
# Kalau di-set di Script Properties Apps Script (key: APP_TOKEN), wajib sama di sini.
# Kosongkan kalau Apps Script Anda tidak pakai token (default: terbuka).
SHEETS_API_TOKEN=

# --- WAJIB: NextAuth ---
# Generate via: openssl rand -base64 32
NEXTAUTH_SECRET=

# URL dasar aplikasi (lokal: http://localhost:3000, prod: https://your-app.vercel.app)
NEXTAUTH_URL=http://localhost:3000

# --- WAJIB: Daftar admin (JSON array) ---
# Format: [{"username":"...","password":"...","nama":"..."}]
# Password plain-text (tool internal, URL publik diizinkan).
# Escape tanda kutip ganda tidak perlu — bungkus seluruh value dengan tanda kutip tunggal di .env.
ADMIN_USERS=[{"username":"Hayfa","password":"hayko123","nama":"Hayfa"},{"username":"Kiko","password":"hayko123","nama":"Kiko"}]
