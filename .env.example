# ===== Hayko Order Manager — Environment Variables (TEMPLATE) =====
# Copy file ini menjadi ".env.local" untuk dev lokal, atau set di Vercel dashboard untuk production.
# File ini TIDAK berisi secret — hanya template.

# --- WAJIB: Vercel Postgres connection string ---
# Didapat setelah create Vercel Postgres database (dashboard Vercel → Storage).
# Format: postgres://user:password@host:port/dbname
POSTGRES_URL=

# Alternatif terpisah (opsional, Vercel Postgres biasanya set keduanya):
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=

# --- WAJIB: NextAuth ---
# Generate via: openssl rand -base64 32
NEXTAUTH_SECRET=

# URL dasar aplikasi (lokal: http://localhost:3000, prod: https://your-app.vercel.app)
NEXTAUTH_URL=http://localhost:3000
